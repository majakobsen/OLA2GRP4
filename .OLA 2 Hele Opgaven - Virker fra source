# Lav tabeller med kvartal, faktisk realvækst og forbrugertillid
resultater_DI <- forbrug_DI[, c(
  "Tidsinterval", "Realvaekst", "DI_FTI"
)]

resultater_DST <- forbrug_DST[, c(
  "Tidsinterval", "Realvaekst", "DST_FTI"
)]

# Beregn modellens forudsagte realvækst: y = a + b * x
# coef() henter konstantleddet (a) og koefficienten (b) fra modellen
resultater_DI$Forudsagt <-
  coef(model_DI)[["(Intercept)"]] +
  coef(model_DI)[["DI_FTI"]] * resultater_DI$DI_FTI

# Samme beregning med DST's forbrugertillidsindikator
resultater_DST$Forudsagt <-
  coef(model_DST)[["(Intercept)"]] +
  coef(model_DST)[["DST_FTI"]] * resultater_DST$DST_FTI

# Vis tabellerne med faktisk og forudsagt realvækst
View(resultater_DI)
View(resultater_DST)

# --------------------------------------------------
# OPGAVE 3.2
# --------------------------------------------------

# Beregn residualer for de to modeller, og indsæt i tabel fra 3.1
resultater_DI$Residual <-
  resultater_DI$Realvaekst - resultater_DI$Forudsagt

resultater_DST$Residual <-
  resultater_DST$Realvaekst - resultater_DST$Forudsagt

# Vis kvartaler, faktiske værdier, forudsigelser og residualer
View(resultater_DI)
View(resultater_DST)

# Saml resultaterne til graferne
residualdata <- rbind(
  data.frame(
    Tidsinterval = resultater_DI$Tidsinterval,
    Model = "DI's forbrugertillidsindikator",
    Forudsagt = resultater_DI$Forudsagt,
    Residual = resultater_DI$Residual
  ),
  data.frame(
    Tidsinterval = resultater_DST$Tidsinterval,
    Model = "DST's forbrugertillidsindikator",
    Forudsagt = resultater_DST$Forudsagt,
    Residual = resultater_DST$Residual
  )
)

#Lav GG Plot

ggplot(
  residualdata,
  aes(x = Forudsagt, y = Residual)
) +
  geom_point(
    colour = "#1595D3",
    size = 2,
    alpha = 0.7
  ) +
  geom_hline(
    yintercept = 0,
    linetype = "dashed",
    colour = "#666666"
  ) +
  facet_wrap(~ Model, ncol = 2) +
  labs(
    title = "Residualer for DI- og DST-modellen",
    subtitle = "Hvert punkt repræsenterer ét kvartal",
    x = "Forudsagt årlig realvækst (%)",
    y = "Residual (procentpoint)",
    caption = "Kilde: Egne beregninger på modellerne fra opgave 2."
  ) +
  theme_minimal()

# --------------------------------------------------
# OPGAVE 3.3 - RSS OG TSS
# --------------------------------------------------

# RSS: Summen af de kvadrerede residualer
RSS_DI <- sum(resultater_DI$Residual^2)

RSS_DST <- sum(resultater_DST$Residual^2)


# Beregn gennemsnittet af den faktiske realvækst
gennemsnit_DI <- mean(resultater_DI$Realvaekst)

gennemsnit_DST <- mean(resultater_DST$Realvaekst)


# TSS: Summen af de kvadrerede afvigelser fra gennemsnittet
TSS_DI <- sum(
  (resultater_DI$Realvaekst - gennemsnit_DI)^2
)

TSS_DST <- sum(
  (resultater_DST$Realvaekst - gennemsnit_DST)^2
)


# Saml resultaterne i en tabel
RSS_TSS <- data.frame(
  Model = c("DI", "DST"),
  RSS = c(RSS_DI, RSS_DST),
  TSS = c(TSS_DI, TSS_DST)
)

View(RSS_TSS)
print(RSS_TSS)


# --------------------------------------------------
# OPGAVE 3.4 - FORKLARINGSGRADEN
# --------------------------------------------------

# Ligningen for forklaringsgraden:
# R^2 = 1 - RSS / TSS

R2_DI <- 1 - RSS_DI / TSS_DI

R2_DST <- 1 - RSS_DST / TSS_DST

# Saml forklaringsgraden for begge modeller
forklaringsgrad <- data.frame(
  Model = c("DI", "DST"),
  R2 = c(R2_DI, R2_DST),
  Forklaringsgrad_pct = c(R2_DI, R2_DST) * 100
)

View(forklaringsgrad)
print(forklaringsgrad)


