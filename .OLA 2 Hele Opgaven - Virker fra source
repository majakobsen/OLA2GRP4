  arrange(geo, time) |>
  group_by(geo) |>
  mutate(
    realvaekst_pct = 100 * (values / lag(values, 4) - 1)
  ) |>
  ungroup() |>
  filter(time >= "2000-Q1", time <= "2026-Q2")

