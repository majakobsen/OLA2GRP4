realvaekst_tabel <- realvaekst |>
  select(time, geo, realvaekst_pct) |>
  pivot_wider(
    names_from = geo,
    values_from = realvaekst_pct
  ) |>
  arrange(time) |>
  select(time, DK, BE, NL, SE, AT, DE, FR, IT, ES) |>
  mutate(across(where(is.numeric), ~ round(.x, 2)))

