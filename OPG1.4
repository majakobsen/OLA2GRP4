# Opgave 1.4

library(ggplot2)

# Behold kun relevante kol
boligoversigt <- samlet %>%
  select(by, pris, kvmpris, bykategori)

View(boligoversigt)

# Beregn gennemsnit for hver bykategori
plotdata <- boligoversigt %>%
  group_by(bykategori) %>%
  summarise(gennemsnit_kvmpris = mean(kvmpris))

# Tegn søjlediagram
ggplot(
  plotdata,
  aes(x = bykategori, y = gennemsnit_kvmpris, fill = bykategori)
) +
  geom_col(show.legend = FALSE) +
  geom_text(
    aes(
      label = paste0(
        format(round(gennemsnit_kvmpris, 0), big.mark = ".", trim = TRUE),
        " kr."
      )
    ),
    vjust = -0.5,
    size = 4
  ) +
  scale_y_continuous(
    expand = expansion(mult = c(0, 0.15))
  ) +
  labs(
    title = "Boliger i storbyer har den højeste\n gennemsnitlige kvadratmeterpris",
    subtitle = "Gennemsnit for boligerne i det undersøgte datasæt",
    x = "Bykategori",
    y = "Gennemsnitlig kvadratmeterpris (kr.)",
    caption = paste(
      "Bykategorier efter indbyggertal:",
      "Storby: mindst 250.000 | Større by: 20.000–249.999",
      "Mellemstor by: 5.000–19.999 | Mindre by: 201–4.999",
      "Landsby / landdistrikt: højst 200.",
      "Kilde: Egne beregninger på baggrund af data fra Boligsiden",
      "og Danmarks Statistik, tabel BY3.",
      sep = "\n"
    )) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold"),
    plot.caption = element_text(hjust = 0)
  )
#Data fra boligsiden og DST:BY3 samt egne beregninger
