# Se datasættet
str(ftillid)
head(ftillid)


# Fjerner første kolonne med indikatornavne
ftillid_clean <- ftillid[, -1]


# Gør alle værdier numeriske
ftillid_num <- as.data.frame(
  lapply(ftillid_clean, as.numeric)
)


# Beholder de oprindelige månedsnavne
# fx 2000M01, 2000M02 osv.
colnames(ftillid_num) <- colnames(ftillid_clean)


# Henter månedsnavnene
tid <- colnames(ftillid_num)


# Finder år
# fx "2000M01" -> "2000"
aar <- substr(tid, 1, 4)


# Finder måned
# fx "2000M01" -> 1
maaned <- as.numeric(
  substr(tid, 6, 7)
)


# Finder hvilket kvartal måneden tilhører
kvartal <- ifelse(
  maaned <= 3, "K1",
  ifelse(
    maaned <= 6, "K2",
    ifelse(
      maaned <= 9, "K3",
      "K4"
    )
  )
)


# Samler år og kvartal
# fx 2000 + K1 -> 2000K1
tidsinterval <- paste0(
  aar,
  kvartal
)


# Finder alle forskellige kvartaler
kvartaler <- unique(tidsinterval)


# Opretter et tomt dataframe
# Samme antal rækker som indikatorer
# Én kolonne pr. kvartal
ftillid_kvt <- data.frame(
  matrix(
    NA,
    nrow = nrow(ftillid_num),
    ncol = length(kvartaler)
  )
)


# --------------------------------------------------
# BEREGNER KVARTALSGENNEMSNIT
# --------------------------------------------------

# Går igennem ét kvartal ad gangen
for (i in 1:length(kvartaler)) {
  
  # Finder hvilke måneder der hører til kvartalet
  kolonner <- which(
    tidsinterval == kvartaler[i]
  )
  
  # Beregner gennemsnittet af månederne
  ftillid_kvt[, i] <- rowMeans(
    ftillid_num[, kolonner, drop = FALSE],
    na.rm = TRUE
  )
}


# Sætter kvartaler som kolonnenavne
colnames(ftillid_kvt) <- kvartaler


# Sætter indikatornavnene tilbage som rækkenavne
rownames(ftillid_kvt) <- ftillid[[1]]


