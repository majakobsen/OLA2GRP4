##HENT DI-FTI IND

DIFTI <- read_excel("DIFTI.xlsx")

#check rækker og kolonner
str(DIFTI)
head(DIFTI)
tail(DIFTI)
colnames(DIFTI)

#Fjern de to første rækker
DIFTI_clean <- DIFTI[-c(1, 2), ]
head(DIFTI_clean)


names(DIFTI_clean) <- c(
  "Tid",
  "fm_nu",
  "dk_nu",
  "forbrugsgoder_nu",
  "forbrugsgoder_frem"
)

#Gør spørgsmålene numeriske

DIFTI_clean[, 2:5] <- lapply(
  DIFTI_clean[, 2:5],
  as.numeric
)

str(DIFTI_clean)
head(DIFTI_clean)
tail(DIFTI_clean)

#Gør måneder til kvartaler i DI-FTI

# Opret tom kolonne til kvartaler
DIFTI_clean$Tidsinterval <- NA

# Gå igennem én række ad gangen
for (i in 1:nrow(DIFTI_clean)) {
  
  # Finder året
  aar <- substr(DIFTI_clean$Tid[i], 1, 4)
  
  # Finder måneden
  maaned <- as.numeric(substr(DIFTI_clean$Tid[i], 6, 7))
  
  # Finder hvilket kvartal måneden tilhører
  if (maaned <= 3) {
    kvartal <- "K1"
    
  } else if (maaned <= 6) {
    kvartal <- "K2"
    
  } else if (maaned <= 9) {
    kvartal <- "K3"
    
  } else {
    kvartal <- "K4"
  }
  
  # Sammensætter fx 2026 og K3 til 2026K3
  DIFTI_clean$Tidsinterval[i] <- paste0(aar, kvartal)
}

DIFTI_clean[["Tidsinterval"]] <- NA_character_

tail(DIFTI_clean)

#LAV GENNEMSNIT AF DE FIRE DI SPØRGSMÅL
# Finder alle unikke kvartaler
kvartaler <- unique(DIFTI_clean$Tidsinterval)

# Opretter tomt dataframe til kvartalsdata
DIFTI_kvt <- data.frame(
  Tidsinterval = character(),
  fm_nu = numeric(),
  dk_nu = numeric(),
  forbrugsgoder_nu = numeric(),
  forbrugsgoder_frem = numeric()
)

# Går igennem ét kvartal ad gangen
for (i in 1:length(kvartaler)) {
  
  # Vælger de rækker der hører til det aktuelle kvartal
  kvartal_data <- DIFTI_clean[
    DIFTI_clean$Tidsinterval == kvartaler[i],
  ]
  
  # Beregner gennemsnit for de fire spørgsmål
  ny_række <- data.frame(
    Tidsinterval = kvartaler[i],
    fm_nu = mean(kvartal_data$fm_nu, na.rm = TRUE),
    dk_nu = mean(kvartal_data$dk_nu, na.rm = TRUE),
    forbrugsgoder_nu = mean(kvartal_data$forbrugsgoder_nu, na.rm = TRUE),
    forbrugsgoder_frem = mean(kvartal_data$forbrugsgoder_frem, na.rm = TRUE)
  )
  
  # Tilføjer rækken til det nye dataframe
  DIFTI_kvt <- rbind(DIFTI_kvt, ny_række)
}

#Simpelt gennemsnit af de fire spørgsmål i hvert kvartal
DIFTI_kvt$DI_FTI <- (
  DIFTI_kvt$fm_nu +
    DIFTI_kvt$dk_nu +
    DIFTI_kvt$forbrugsgoder_nu +
    DIFTI_kvt$forbrugsgoder_frem
) / 4

head(DIFTI_kvt)
tail(DIFTI_kvt)


#Merge privatforbrug og DIfti i interval af kvartaler
forbrug_DI <- merge(
  DIFTI_kvt,
  privatforbrug,
  by = "Tidsinterval"
)

head(forbrug_DI)
tail(forbrug_DI)
str(forbrug_DI)

#Regression
model_DI <- lm(
  Realvaekst ~ DI_FTI,
  data = forbrug_DI
)
summary(model_DI)




