# --------------------------------------------------
# OPGAVE 4.1
# --------------------------------------------------

#data prep
library(dkstat)

# Hent data i et separat objekt
forbrugertillid_raw <- dst_get_data(
  table = "FORV1",
  query = list(
    INDIKATOR = "Forbrugertillidsindikatoren",
    TID = "*"
  ),
  lang = "da",
  parse_dst_tid = FALSE
)

# Lav de to kolonner som på billedet
forbrugertillid <- data.frame(
  tid = forbrugertillid_raw$TID,
  ftillid = forbrugertillid_raw$value
)

# Vælg perioden og sortér månederne
forbrugertillid <- forbrugertillid[
  forbrugertillid$tid >= "1996M01" &
    forbrugertillid$tid <= "2026M09",
]

forbrugertillid <- forbrugertillid[
  order(forbrugertillid$tid),
]

rownames(forbrugertillid) <- NULL

View(forbrugertillid)

#Lav til kvartaler
forbrugertillid$ftillid <- as.numeric(forbrugertillid$ftillid)

ftillid <- ts(forbrugertillid$ftillid,
              start = c(1996, 1),
              frequency = 12)

ftillid_kvartal <- aggregate(ftillid,
                             nfrequency = 4,
                             FUN = mean)
ftillid_kvartal

#graf 

plot(
  ftillid_kvartal,
  type = "l",
  main = "Danskernes forbrugertillid er\nlangt fra tilbage i plus",
  xlab = "År",
  ylab = "Forbrugertillidsindikator"
)

abline(h = 0, lty = 2)

mtext(
  "Kvartalsgennemsnit af forbrugertilliden i Danmark 1996-2026",
  side = 1, line = 4, cex = 0.7
)

mtext(
  "Kilde: Egne beregninger på baggrund af DST, tabel FORV1.",
  side = 1, line = 5, cex = 0.7
)
