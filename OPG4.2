spg <- read_excel("/Users/emmasofiehojelse/Downloads/202692414856663246794FORV1.xlsx")

View(spg)

spg <- spg[-c(1,2), ]

View(spg)

colnames(spg) <- c("tid", "spg")

spg$spg <- as.numeric(spg$spg)

spg_ts <- ts(spg$spg,
             start = c(2000, 1),
             frequency = 12)

spg_kvartal <- aggregate(spg_ts,
                         nfrequency = 4,
                         FUN = mean)

spg_kvartal

mean(spg_kvartal)

